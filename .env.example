# =============================================================
# Playoff Hoops — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# PostgreSQL (used by docker-compose AND by the backend)
POSTGRES_USER=playoff
POSTGRES_PASSWORD=playoff_dev
POSTGRES_DB=playoff_hoops
DATABASE_URL=postgresql://playoff:playoff_dev@db:5432/playoff_hoops

# Backend auth
SECRET_KEY=dev-secret-change-in-prod

# OpenAI (optional — needed only for scouting reports)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_LINEUP_MODEL=gpt-5.1-mini
