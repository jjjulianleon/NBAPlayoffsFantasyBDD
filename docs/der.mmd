erDiagram
    users {
        INT user_id PK
        VARCHAR username UK
        VARCHAR email UK
        VARCHAR password_hash
        VARCHAR display_name
        TIMESTAMP created_at
        TIMESTAMP last_login
    }

    nba_teams {
        INT team_id PK
        VARCHAR abbreviation UK
        VARCHAR full_name
        ENUM conference
        SMALLINT playoff_seed
        BOOLEAN is_eliminated
        SMALLINT eliminated_round
    }

    team_elimination_log {
        INT log_id PK
        INT team_id FK
        BOOLEAN previous_is_eliminated
        BOOLEAN new_is_eliminated
        SMALLINT previous_round
        SMALLINT new_round
        TIMESTAMP changed_at
    }

    players {
        INT player_id PK
        VARCHAR first_name
        VARCHAR last_name
        INT team_id FK
        VARCHAR position
        VARCHAR jersey_number
        BOOLEAN is_active
        DECIMAL season_ppg
        DECIMAL season_rpg
        DECIMAL season_apg
    }

    games {
        VARCHAR game_id PK
        DATE game_date
        INT home_team_id FK
        INT away_team_id FK
        INT home_score
        INT away_score
        ENUM status
        SMALLINT playoff_round
        INT series_id
        SMALLINT game_number_in_series
    }

    player_game_stats {
        INT stat_id PK
        INT player_id FK
        VARCHAR game_id FK
        INT minutes_played
        INT points
        INT rebounds
        INT assists
        INT steals
        INT blocks
        INT turnovers
        INT fg_made
        INT fg_attempted
        INT three_made
        INT three_attempted
        INT ft_made
        INT ft_attempted
        INT plus_minus
        DECIMAL fantasy_points
    }

    leagues {
        INT league_id PK
        VARCHAR league_name
        INT created_by FK
        SMALLINT max_teams
        ENUM draft_status
        ENUM scoring_type
        TIMESTAMP created_at
        TIMESTAMP draft_date
    }

    league_members {
        INT member_id PK
        INT league_id FK
        INT user_id FK
        ENUM role
        TIMESTAMP joined_at
    }

    fantasy_teams {
        INT fantasy_team_id PK
        VARCHAR team_name
        INT user_id FK
        INT league_id FK
        DECIMAL total_points
        INT rank_in_league
        TIMESTAMP created_at
    }

    roster_players {
        INT roster_id PK
        INT fantasy_team_id FK
        INT player_id FK
        ENUM roster_slot
        BOOLEAN is_active
        ENUM acquired_via
        TIMESTAMP acquired_at
        TIMESTAMP released_at
    }

    draft_picks {
        INT pick_id PK
        INT league_id FK
        INT fantasy_team_id FK
        INT player_id FK
        SMALLINT round_number
        INT pick_number
        TIMESTAMP picked_at
    }

    transactions {
        INT transaction_id PK
        INT fantasy_team_id FK
        INT player_id FK
        ENUM transaction_type
        TIMESTAMP transaction_date
    }

    predictions {
        INT prediction_id PK
        INT player_id FK
        VARCHAR game_id FK
        DECIMAL predicted_points
        DECIMAL predicted_rebounds
        DECIMAL predicted_assists
        DECIMAL predicted_fantasy_pts
        DECIMAL confidence_score
        VARCHAR model_version
        TIMESTAMP created_at
    }

    scouting_reports {
        INT report_id PK
        INT player_id FK
        DATE report_date
        TEXT report_text
        ENUM hot_cold_status
        SMALLINT streak_length
        VARCHAR generated_by
        TIMESTAMP created_at
    }

